# Modelo de Ollama. Opciones razonables:
#   qwen2.5-coder:1.5b  -> ~1 GB, rápido en CPU (default)
#   qwen2.5-coder:7b    -> ~4.7 GB, mucho mejor calidad (ideal con GPU o 16 GB de RAM)
#   deepseek-coder-v2:16b, codellama:7b, etc.
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TEMPERATURE=0.2

# Puerto donde queda la interfaz web
APP_PORT=8080
